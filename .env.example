# ===================================================================
# anm-db .env (exemplo)
# Copie para .env e preencha com seus valores reais
# ===================================================================

# Banco de dados SQLite (padrao: ./anm.db)
DB_PATH=anm.db

# API
API_HOST=0.0.0.0
API_PORT=8000

# Scraper - Animefire (rate limit conservador para 1 OCPU)
REQ_CATALOGO=3
REQ_EPISODIOS=2
CONCURRENCY_CATALOGO=3
CONCURRENCY_EPISODIOS=3

# Gemini (traducao PT-BR) - https://aistudio.google.com/apikey
# Se vazio, traducao e desativada (apenas loga warning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=15
GEMINI_RPD=1500
TRANSLATION_BATCH_SIZE=10
TRANSLATION_ENABLED=true

# Download / ffmpeg
FFMPEG_PATH=ffmpeg
DOWNLOAD_CHUNK_SIZE=65536
